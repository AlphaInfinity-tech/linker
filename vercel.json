{
  "rewrites": [
    { "source": "/admin", "destination": "/public/admin.html" },
    { "source": "/consent", "destination": "/api/consent.py" },
    { "source": "/submit-location", "destination": "/api/submit_location.py" },
    { "source": "/api/sessions/(.*)", "destination": "/api/sessions.py" },
    { "source": "/api/(.*)", "destination": "/api/$1.py" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
